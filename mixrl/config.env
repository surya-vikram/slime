# MixRL run settings: the one file to edit (which tasks run is in tasks.json).
# Override any value for a single command, e.g.  LR=2e-6 mixrl/run.sh start my-run
# Sourced by judge.sh, reward.sh and run.sh on the host, and by internal/launch.sh in the
# training container, so every setting has exactly one default.

# ---- Host layout ------------------------------------------------------------------------
# $BASE_DIR holds models/, datasets/, repos/, runs/ and cache/ (see docs/AIRGAPPED.md).
BASE_DIR=${BASE_DIR:-/nvme_zone3/home/ekamai1/chimera/mixrl}
MODEL_NAME=${MODEL_NAME:-zoro2}  # models/$MODEL_NAME/{hf,mcore}
DATASET_NAME=${DATASET_NAME:-chimera-eval-data}                         # datasets/$DATASET_NAME
TRANSFORMERS_DIR=${TRANSFORMERS_DIR:-$BASE_DIR/repos/transformers}      # Chimera transformers checkout
EVAL_REPO=${EVAL_REPO:-$BASE_DIR/repos/chimera-eval}                    # reward service code
SLIME_IMAGE=${SLIME_IMAGE:-suryavikram6/slime:pinned}
EVAL_IMAGE=${EVAL_IMAGE:-suryavikram6/chimera-eval:0.1.1}

# ---- Training GPUs and batch shape ------------------------------------------------------
TRAIN_GPUS=${TRAIN_GPUS:-0,1,2,3,4,5}                          # host GPU ids for training
POLICY_GPUS=${POLICY_GPUS:-6}                          # must equal the number of TRAIN_GPUS
EXPERT_MODEL_PARALLEL_SIZE=${EXPERT_MODEL_PARALLEL_SIZE:-1}
N_SAMPLES_PER_PROMPT=${N_SAMPLES_PER_PROMPT:-16}        # responses per prompt (prompts per step: tasks.json)

# ---- Schedule ---------------------------------------------------------------------------
NUM_ROLLOUT=${NUM_ROLLOUT:-300}                         # training steps (~3 days on 8xH200); extend a run on resume with MIXRL_EXTEND_CONSTANT_HORIZON=1 (README)
LR=${LR:-1e-6}
LR_WARMUP_STEPS=${LR_WARMUP_STEPS:-10}                # linear warmup, then constant (DAPO recipe: 10 at LR 1e-6; Adam starts fresh)
EVAL_INTERVAL=${EVAL_INTERVAL:-10}                     # also evaluates at the end
EVAL_BEFORE_TRAIN=${EVAL_BEFORE_TRAIN:-1}              # 1: evaluate the starting model first; 0: skip it
SAVE_INTERVAL=${SAVE_INTERVAL:-20}                     # checkpoint every N steps (and at the end)
NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-0}                      # 0: weights and optimizer state (~130 GB per checkpoint for the 9.5B model; needed for mixrl/run.sh resume); 1: weights only (~19 GB, the run cannot resume)
MIXRL_WALLCLOCK_SECONDS=${MIXRL_WALLCLOCK_SECONDS:-0}  # >0: stop cleanly at a step boundary, leaving time to save
MIXRL_STOP_FILE=${MIXRL_STOP_FILE:-}                   # container path; create it to stop after the current step
MIXRL_KEEP_TRAIN_SAMPLES=${MIXRL_KEEP_TRAIN_SAMPLES:-0} # 1: also write every training response to disk (MBs each, slows rollout); eval responses are always kept
MIXRL_CONSOLE=${MIXRL_CONSOLE:-concise}                # terminal: concise (step lines, progress, warnings, errors) or full (every line); logs/train.log always has everything
MIXRL_CONSOLE_PROGRESS_SECONDS=${MIXRL_CONSOLE_PROGRESS_SECONDS:-60} # one rollout progress line this often in the concise view

# ---- Throughput (does not change results) -----------------------------------------------
MIXRL_INFLIGHT_GROUPS=${MIXRL_INFLIGHT_GROUPS:-192}             # prompt groups generated/graded at once
MIXRL_RESPONSE_CONCURRENCY=${MIXRL_RESPONSE_CONCURRENCY:-1536}   # generation requests at once
MIXRL_REWARD_CONCURRENCY=${MIXRL_REWARD_CONCURRENCY:-512}      # reward service requests at once
MIXRL_DISTRIBUTED_POST=${MIXRL_DISTRIBUTED_POST:-0}   # 1: SGLang calls and reply parsing in Ray worker processes, off the rollout event loop
MIXRL_COLLECTION_TIMEOUT=${MIXRL_COLLECTION_TIMEOUT:-86400}     # seconds allowed for one step's rollout or one eval
MIXRL_REWARD_TIMEOUT=${MIXRL_REWARD_TIMEOUT:-7200}      # seconds one /score request may take (judge queue + up to 6 judge calls)
MIXRL_REWARD_ATTEMPTS=${MIXRL_REWARD_ATTEMPTS:-12}        # /score retries on 5xx before the run stops
MIXRL_REWARD_BACKOFF_MAX=${MIXRL_REWARD_BACKOFF_MAX:-120}  # longest sleep (s) between /score retries; 12 attempts span ~10 min
MIXRL_HEALTH_WAIT_SECONDS=${MIXRL_HEALTH_WAIT_SECONDS:-3600} # before each step, wait up to 1 h for a restarting judge/reward service instead of stopping
SGLANG_CUDA_GRAPH_MAX_BS=${SGLANG_CUDA_GRAPH_MAX_BS:-256}
SGLANG_MEM_FRACTION_STATIC=${SGLANG_MEM_FRACTION_STATIC:-0.80}
SGLANG_MAX_RUNNING_REQUESTS=${SGLANG_MAX_RUNNING_REQUESTS:-384}   # per engine; launch.sh reads it, run.sh only forwards names listed here

# ---- Reward service and judge -----------------------------------------------------------
REWARD_PORT=${REWARD_PORT:-18020}
REWARD_PROCESSES=${REWARD_PROCESSES:-8}             # reward-service processes on ports REWARD_PORT, +1, ...; one process grades on one CPU core
REWARD_WORKERS=${REWARD_WORKERS:-8192}                # reward-service request threads in total (split across processes); keep > MIXRL_REWARD_CONCURRENCY or excess requests get HTTP 503
CODE_CONCURRENCY=${CODE_CONCURRENCY:-32}                # APPS sandboxes running at once in total (chimera-eval default is 2)
JUDGE_HOST=${JUDGE_HOST:-127.0.0.1}                    # where the reward service reaches the judge
JUDGE_PORT=${JUDGE_PORT:-8025}
JUDGE_NAME=${JUDGE_NAME:-mixrl-judge}
JUDGE_MODEL_DIR=${JUDGE_MODEL_DIR:-Muse-Glimmer-30B}   # models/$JUDGE_MODEL_DIR
JUDGE_GPUS=${JUDGE_GPUS:-6,7}                            # host GPU ids for the judge
JUDGE_TP=${JUDGE_TP:-1}                                # tensor parallel size per judge replica
JUDGE_DP=${JUDGE_DP:-2}                                # judge replicas; JUDGE_GPUS lists JUDGE_TP x JUDGE_DP GPUs (the 30B judge fits one H200: two replicas beat one TP=2 replica on throughput)
JUDGE_MAX_MODEL_LEN=${JUDGE_MAX_MODEL_LEN:-32768}      # up to 131072
JUDGE_CONTEXT=${JUDGE_CONTEXT:-32768}                  # reward service's judge budget; <= JUDGE_MAX_MODEL_LEN
JUDGE_MAX_TOKENS=${JUDGE_MAX_TOKENS:-1024}
# Muse Glimmer's chat template has no enable_thinking switch (it was ignored, so the judge reasoned at its
# default 'high'); reasoning_strength low gave the same verdicts as high on 500 calls with ~60% fewer tokens.
JUDGE_CHAT_TEMPLATE_KWARGS=${JUDGE_CHAT_TEMPLATE_KWARGS:-'{"reasoning_strength":"low"}'}
JUDGE_MAX_RETRY_TOKENS=${JUDGE_MAX_RETRY_TOKENS:-4096}
JUDGE_CONCURRENCY=${JUDGE_CONCURRENCY:-256}             # judge calls in flight from the reward service, in total
JUDGE_KV_CACHE_NUM_TOKENS=${JUDGE_KV_CACHE_NUM_TOKENS:-9000000} # >0: admit judge calls while their reserved prompt + max output tokens fit this budget
                                                       # (in total) instead of the fixed JUDGE_CONCURRENCY; 0: off. A call reserves ~4K but holds ~600 KV tokens
                                                       # (shared prefixes), so the request cap binds first: 9M admits ~2048 calls, the 2 replicas' cap
JUDGE_MAX_PENDING=${JUDGE_MAX_PENDING:-2048}            # with the KV budget: judge calls in flight, in total; = JUDGE_DP x JUDGE_MAX_NUM_SEQS so none wait inside vLLM
JUDGE_MAX_NUM_SEQS=${JUDGE_MAX_NUM_SEQS:-1024}            # requests running at once per judge replica (vLLM 0.28 defaults to 512); 0 = vLLM's default
JUDGE_MAX_NUM_BATCHED_TOKENS=${JUDGE_MAX_NUM_BATCHED_TOKENS:-32768} # tokens per judge forward pass (prefill chunk size)
# DFlash off: at ~400 concurrent judge calls it gave ~40% fewer tokens/s than plain decoding on one H200 and its
# drafter cut the KV cache from 2.56M to 1.57M tokens. It may still help a judge that runs only a few calls at once.
JUDGE_SPECULATIVE=${JUDGE_SPECULATIVE:-0}              # 1: DFlash speculative decoding when the drafter is present; 0: off
JUDGE_SPECULATIVE_TOKENS=${JUDGE_SPECULATIVE_TOKENS:-5}  # DFlash tokens per step
JUDGE_KV_CACHE_DTYPE=${JUDGE_KV_CACHE_DTYPE:-fp8}       # fp8 roughly doubles the judge's KV cache
JUDGE_PERFORMANCE_MODE=${JUDGE_PERFORMANCE_MODE:-throughput}
JUDGE_LANGUAGE_MODEL_ONLY=${JUDGE_LANGUAGE_MODEL_ONLY:-1}  # 1: skip the vision encoder (text-only judging)
JUDGE_API_SERVERS=${JUDGE_API_SERVERS:-2}              # vLLM front-end processes; each judge call is tokenized there twice (/tokenize, then the request)
JUDGE_REQUEST_TIMEOUT=${JUDGE_REQUEST_TIMEOUT:-1800}    # reward service -> judge, seconds per call (chimera-eval default 180)
JUDGE_REQUEST_RETRIES=${JUDGE_REQUEST_RETRIES:-6}      # reward service -> judge retries on timeouts/5xx (chimera-eval default 2)
JUDGE_ATTEMPTS=${JUDGE_ATTEMPTS:-4}                    # judge re-asks when a verdict is cut off or unparseable (chimera-eval default 3)
JUDGE_GPU_MEMORY_UTILIZATION=${JUDGE_GPU_MEMORY_UTILIZATION:-0.88} # 0.95 ran out of memory in DFlash warmup on one H200
JUDGE_USE_DOCKER=${JUDGE_USE_DOCKER:-1}                # 1: run vLLM from JUDGE_IMAGE instead of a local install
JUDGE_IMAGE=${JUDGE_IMAGE:-vllm/vllm-openai:muse-glimmer}

# ---- Recipe (the locked MixRL baseline; resume refuses changes) --------------------------
CONTEXT_PHASE=${CONTEXT_PHASE:-32k}                    # must match the checkpoint's YaRN phase
TRAIN_SEQUENCE_LENGTH=${TRAIN_SEQUENCE_LENGTH:-16384}  # prompt + response: the policy's hard limit
MAX_TOKENS_PER_GPU=${MAX_TOKENS_PER_GPU:-16384}
MIXRL_CONTEXT_HEADROOM=${MIXRL_CONTEXT_HEADROOM:-1024}
MIXRL_OBJECTIVE=${MIXRL_OBJECTIVE:-mimo}
USE_ROLLOUT_LOGPROBS=${USE_ROLLOUT_LOGPROBS:-1}        # 1: skip the actor's extra log-prob pass, unused by the mimo loss (see README); dapo needs 0
MIXRL_TRUNCATION=${MIXRL_TRUNCATION:-zero}             # no finished answer (cut off at the cap, or <think> never closed): zero = scored 0 like a wrong answer (MiMo, DAPO); mask = left out of the loss
MIXRL_LENGTH_PENALTY=${MIXRL_LENGTH_PENALTY:-1}        # MiMo group-relative length penalty: up to -0.1 for correct answers far longer than the group's (1/0)
MIXRL_OVERSAMPLE=${MIXRL_OVERSAMPLE:-0.3}              # spare groups in flight per task, as a fraction of its quota, so uniform groups are replaced without waiting; same batch as 0 (only faster); 0 = off
MIXRL_REFILL_ROUNDS=${MIXRL_REFILL_ROUNDS:-2}          # replace groups without reward spread, up to (1 + N) x prompts_per_step prompts per task per step; 0 = off
ROLLOUT_TEMPERATURE=${ROLLOUT_TEMPERATURE:-1.0}        # MiMo's public recipes
ROLLOUT_TOP_P=${ROLLOUT_TOP_P:-0.95}                   # < 1 replays each token's top-p candidate set in the loss (MiMo); eval samples the same way
ROLLOUT_TOP_K=${ROLLOUT_TOP_K:-20}                     # MiMo code recipe, Qwen3 default; -1 = off. Needs ROLLOUT_TOP_P < 1 (the replay switch)
MIXRL_SEED=${MIXRL_SEED:-42}
WEIGHT_DECAY=${WEIGHT_DECAY:-0}
CLIP_GRAD=${CLIP_GRAD:-1.0}
ADAM_BETA1=${ADAM_BETA1:-0.9}
ADAM_BETA2=${ADAM_BETA2:-0.98}
